# =====================================================================
# Docker Environment Configuration
# Copy to .env in the same directory as docker-compose.yml
# =====================================================================

# Application
APP_ENV=production
APP_NAME="Warehouse Management System - Lintasarta"
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_PORT=8080

# Database (used by both app + mysql container)
DB_DRIVER=mysql
DB_USER=wms_user
DB_PASSWORD=wms_secure_password
DB_NAME=dashboard_db
DB_EXTERNAL_PORT=3307

# MySQL root password
MYSQL_ROOT_PASSWORD=root_secure_password

# Session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# phpMyAdmin (only with --profile dev)
PMA_PORT=8081
