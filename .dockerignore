# =====================================================================
# Warehouse Management System (WMS) - Docker Ignore
# =====================================================================
# Reducing build context speeds up `docker build` dramatically.
# Every file NOT listed here gets sent to the Docker daemon on each build.
# =====================================================================

# ── Version control ─────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Dependencies (not used at runtime — no npm install in Dockerfile) ─
node_modules
package.json
package-lock.json

# ── SCSS sources (only compiled CSS in frontend/css is needed) ──────
frontend/scss

# ── Docker / environment files ──────────────────────────────────────
docker-compose.yml
docker-compose.*.yml
Dockerfile
Dockerfile.*
.dockerignore
.env
.env.*

# ── Uploads (should be mounted as a volume, not baked into image) ──
uploads

# ── Logs ────────────────────────────────────────────────────────────
*.log
logs
*.log.*
npm-debug.log*
apache_logs
error.log
access.log

# ── IDE and editor files ───────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.project
.settings
.classpath
*.sublime-project
*.sublime-workspace
.agents

# ── OS files ───────────────────────────────────────────────────────
Thumbs.db
.DS_Store
Desktop.ini
ehthumbs.db

# ── Temporary, test, and scratch files ─────────────────────────────
output.txt
temp.json
temp_rack.json
test_output.json
api/test_output.json
*.tmp
*.bak
*.orig
*.cache
backend/scratch_*.php

# ── Documentation (not needed at runtime) ──────────────────────────
README.md
LICENSE
CHANGELOG.md
docs
*.md
!docker-entrypoint.sh
