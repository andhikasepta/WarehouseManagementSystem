# =====================================================================
# Warehouse Management System (WMS) - Optimized .dockerignore
# =====================================================================
# Minimizes Docker build context to maximize build speed & security.
# =====================================================================

# ── Version Control ─────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# ── Environment & Secret Files ──────────────────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.pub
*.ppk

# ── Logs & Debugging (All Log Files & Directories) ───────────────────
*.log
**/*.log
*.log.*
**/*.log.*
logs/
**/logs/
log/
**/log/
apache_logs/
**/apache_logs/
storage/logs/
backend/logs/
var/log/
error.log
access.log
*.err
**/*.err
*.out
**/*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Uploads & User Generated Content (Mounted as Volume) ────────────
uploads/
uploads/**
storage/
storage/**
storage_hub/
storage_hub/**
backend/uploads/
api/uploads/

# ── Database Dumps, SQLite & Backups ────────────────────────────────
*.sql
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# ── Test & Scratch Scripts (Excluded from Production Container) ─────
tests/
test/
**/tests/
**/test/
test_*.php
**/test_*.php
scratch_*.php
**/scratch_*.php
backend/scratch_*.php
backend/test_*.php
api/test_*.php
scratch/
**/scratch/
scratch_verify.php
test_gr_api.php
test_gr_count.php

# ── Temporary & Cache Files ─────────────────────────────────────────
*.tmp
*.temp
*.cache
.cache/
**/.cache/
temp/
tmp/
**/temp/
**/tmp/
temp.json
temp_rack.json
output.txt
test_output.json
api/test_output.json
**/test_output.json
.redis_offline
**/.redis_offline
*.flag
**/*.flag
phpunit.xml*
.phpunit.result.cache
.phpunit.cache/
coverage/
.coverage/
.php-cs-fixer.cache

# ── Node.js, Build Tooling & Lockfiles ──────────────────────────────
node_modules/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
gulpfile.js
.sass-cache/

# ── Uncompiled Assets & Source Maps (Faster Build & Compact Image) ──
# Style sources (compiled CSS is used in production)
**/*.scss
**/*.less
frontend/scss/
frontend/vendor/**/scss/
frontend/vendor/**/less/
frontend/vendor/bootstrap/scss/

# JavaScript & CSS Source Maps
**/*.map
frontend/vendor/**/*.map

# Unused FontAwesome raw assets (over 1,600 unused SVGs/sprites/metadata)
frontend/vendor/fontawesome-free/svgs/
frontend/vendor/fontawesome-free/sprites/
frontend/vendor/fontawesome-free/less/
frontend/vendor/fontawesome-free/scss/
frontend/vendor/fontawesome-free/metadata/
frontend/vendor/fontawesome-free/package.json
frontend/vendor/fontawesome-free/attribution.js
frontend/vendor/fontawesome-free/LICENSE.txt

# ── IDEs, Editors & AI Workspace Tools ──────────────────────────────
.vscode/
.idea/
.agents/
.gemini/
.antigravity/
.sublime-project
.sublime-workspace
.project
.settings/
.classpath
.buildpath
.editorconfig

# ── Operating System Metadata ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
[Nn]et[Hh]ood
[Pp]rint[Hh]ood

# ── Documentation & Non-Runtime Assets ──────────────────────────────
README.md
CHANGELOG.md
LICENSE
docs/
*.md
**/*.md

# ── Docker Configs (Excluded from COPY . inside web root) ────────────
docker-compose.yml
docker-compose.*.yml
Dockerfile
Dockerfile.*
.dockerignore

# ── EXPLICIT WHITELIST: Ensure runtime configs are included ─────────
!docker-entrypoint.sh
!docker/
!docker/apache/000-default.conf
!docker/php/custom.ini
