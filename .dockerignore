# =====================================================================
# Warehouse Management System (WMS) - Optimized .dockerignore
# =====================================================================
# Minimizes Docker build context to maximize build speed & security.
# =====================================================================

# ── Version Control ─────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# ── Environment & Secret Files ──────────────────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt

# ── Logs & Debugging ────────────────────────────────────────────────
*.log
**/*.log
logs/
log/
apache_logs/
error.log
access.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Uploads & User Generated Content (Mounted as Volume) ────────────
uploads/
storage/
storage_hub/

# ── Database Dumps, SQLite & Migrations Scratch ─────────────────────
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
backend/scratch_*.php
scratch/

# ── Node.js, Build Tooling & Uncompiled Sources ─────────────────────
node_modules/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
gulpfile.js
frontend/scss/
.sass-cache/

# ── IDEs, Editors & AI Workspace Tools ──────────────────────────────
.vscode/
.idea/
.agents/
.gemini/
.antigravity/
.sublime-project
.sublime-workspace
.project
.settings/
.classpath
.buildpath
*.swp
*.swo
*~
*.bak
*.orig
.editorconfig

# ── Operating System Metadata ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
[Nn]et[Hh]ood
[Pp]rint[Hh]ood

# ── Temporary & Scratch Files ───────────────────────────────────────
*.tmp
*.temp
*.cache
.cache/
temp/
tmp/
temp.json
temp_rack.json
output.txt
test_output.json
api/test_output.json

# ── Testing & Code Quality Tools ────────────────────────────────────
tests/
test/
phpunit.xml*
.phpunit.result.cache
.phpunit.cache/
coverage/
.coverage/
.php-cs-fixer.cache

# ── Documentation & Non-Runtime Assets ──────────────────────────────
README.md
CHANGELOG.md
LICENSE
docs/
*.md

# ── Docker Configs (Excluded from COPY . inside image) ──────────────
docker-compose.yml
docker-compose.*.yml
Dockerfile
Dockerfile.*
.dockerignore

# ── EXPLICIT WHITELIST: Ensure runtime configs are included ─────────
!docker-entrypoint.sh
!docker/
!docker/apache/000-default.conf
!docker/php/custom.ini
