# =====================================================================
# Warehouse Management System (WMS) - Environment Example Template
# =====================================================================
# Copy this file to .env and adjust values for your deployment.
# =====================================================================

# ── Application Settings ────────────────────────────────────────────
APP_ENV=production
APP_NAME="Warehouse Management System - Lintasarta"
APP_URL=https://wmsdev.my.id
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# ── Database Configuration ──────────────────────────────────────────
# Select DB_DRIVER: 'pgsql' or 'mysql'
DB_DRIVER=pgsql
DB_HOST=103.123.100.14
DB_PORT=5432
DB_NAME=dashboard_db
DB_USER=deutsch
DB_PASSWORD=S3pt4@

# ── MySQL Container Configuration (if DB_DRIVER=mysql with compose) ──
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=wms_user
MYSQL_PASSWORD=your_database_password

# ── Session & Redis Configuration ───────────────────────────────────
SESSION_SAVE_HANDLER=redis
SESSION_SAVE_PATH="tcp://103.123.100.11:6379?timeout=2.5"
SESSION_LIFETIME=1200
SESSION_SECURE=false
REDIS_HOST=103.123.100.11
REDIS_PORT=6379
REDIS_TIMEOUT=2.5
REDIS_PASSWORD=
REDIS_USER=
REDIS_TLS=false

# ── Docker Ports (host:container mapping) ───────────────────────────
DB_EXTERNAL_PORT=3307
PHPMYADMIN_PORT=8081
