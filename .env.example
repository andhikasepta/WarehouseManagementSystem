# =====================================================================
# Warehouse Management System (WMS) - Environment Example Template
# =====================================================================

APP_ENV=production
APP_NAME="Warehouse Management System - Lintasarta"
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (pgsql / mysql)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=dashboard_db

SESSION_LIFETIME=7200
SESSION_SECURE=false
