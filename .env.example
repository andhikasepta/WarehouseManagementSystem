# =====================================================================
# Warehouse Management System (WMS) - Environment Example Template
# =====================================================================
# Copy this file to .env and adjust values for your environment.
# For Docker: DB_HOST should be 'db' (the docker-compose service name).
# For Local:  DB_HOST should be '127.0.0.1' or 'localhost'.
# =====================================================================

# ── Application Settings ────────────────────────────────────────────
APP_ENV=production
APP_NAME="Warehouse Management System - Lintasarta"
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# ── Database Configuration ──────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=dashboard_db

# MySQL credentials (used by both app and docker-compose db service)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=wms_user
MYSQL_PASSWORD=your_database_password

# ── Session Settings ────────────────────────────────────────────────
SESSION_LIFETIME=7200
SESSION_SECURE=false

# ── Docker Ports (host:container mapping) ───────────────────────────
# External port to access MySQL from host machine
DB_EXTERNAL_PORT=3307

# ── phpMyAdmin (only used with 'dev' profile) ───────────────────────
# Start with: docker-compose --profile dev up -d
PHPMYADMIN_PORT=8081
